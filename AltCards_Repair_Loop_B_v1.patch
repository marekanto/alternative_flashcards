+++ b/agent/orchestrator.py
@@ -7,6 +7,7 @@ Pipeline z samodoskonalącym się feedbackiem QA:
   3. pętla: Code Agent → diff → QA vs ORIGINAL_TASK → refiner → retry.
 """
 import os
